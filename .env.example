# ---------------------------------------------------------------------------
# SentinelX configuration example.
# Copy to `.env` and adjust. NEVER commit real API keys or secrets.
#
# IMPORTANT: SentinelX v0.1 is PAPER TRADING ONLY. It does not place real
# orders and does not connect to any exchange. The keys below are placeholders
# for a future live-data integration (market data / news feed). Leave them
# empty and the agent falls back to the built-in deterministic mock provider.
# ---------------------------------------------------------------------------

# Trading mode. Only "paper" is supported in this version.
SENTINELX_MODE=paper

# --- Optional future data connections (leave blank for now) ----------------
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
NEWS_API_KEY=

# --- Universe -------------------------------------------------------------
SENTINELX_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SENTINELX_STARTING_EQUITY=10000

# --- Risk limits (safe defaults; tighten, never loosen, for demos) --------
SENTINELX_MAX_POSITION_PCT=10
SENTINELX_MAX_RISK_PER_TRADE_PCT=0.5
SENTINELX_MAX_OPEN_POSITIONS=3
SENTINELX_MAX_DAILY_LOSS_PCT=3
SENTINELX_REENTRY_COOLDOWN_MINUTES=30
SENTINELX_MAX_LEVERAGE=1
SENTINELX_MIN_CONFIDENCE=0.5

# --- Demo runner ----------------------------------------------------------
SENTINELX_CYCLES=48
SENTINELX_SEED=1337
SENTINELX_VERBOSE=false
